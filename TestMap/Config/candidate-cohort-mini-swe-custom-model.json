{
  "RuntimeConfig": {
    "Project": {
      "KeepProjectFiles": true,
      "AnalyzeLatestCommit": false
    },
    "FilePaths": {
      "TargetFilePath": "D:\\Projects\\TestMap\\TestMap\\Data\\example_project.txt",
      "LogsDirPath": "D:\\Projects\\TestMap\\TestMap\\Logs",
      "TempDirPath": "D:\\Projects\\TestMap\\Temp",
      "OutputDirPath": "D:\\Projects\\TestMap\\TestMap\\Output"
    },
    "Docker": {
      "DefaultContext": "desktop-linux",
      "WindowsContext": "desktop-windows",
      "WindowsNetwork": "nat",
      "Images": {
        "ValidationSdkAll": "testmap-validation-sdk-all:latest",
        "AgentTools": {
          "mini-swe-agent": "testmap-agent-eval-mini-swe-agent:latest"
        }
      }
    },
    "Frameworks": {
      "NUnit": [ "Test", "TestCase", "TestCaseSource", "Theory" ],
      "xUnit": [ "Fact", "Theory" ],
      "MSTest": [ "TestMethod", "DataSource" ],
      "Microsoft.VisualStudio.TestTools.UnitTesting": [ "TestMethod", "DataSource" ]
    },
    "MaxConcurrency": 1,
    "RunDateFormat": "yyyy-MM-dd"
  },
  "TestingConfig": {
    "GenerationConfig": {
      "Objective": "test-suite-expansion",
      "Provider": "custom-openai",
      "Mode": "chat",
      "MetricsPath": "coverage-and-mutation",
      "BudgetMode": "pass-at1",
      "Temperature": 0,
      "StepErrorRetries": 0,
      "StepRetryDelayMs": 1000,
      "ContextMode": "chained-history",
      "TargetSelection": {
        "Strategy": "existing",
        "CandidateLimit": 2,
        "ContextMappingMode": "heuristic-with-grounded-preference",
        "MaxTestCodeDepth": 3,
        "MaxProductionCallDepth": 3,
        "MaxIndirectInvocationDepth": 2
      },
      "Steps": {
        "EnableEvidencePackage": true,
        "EnableContextGraph": true,
        "EnableContextResolution": true,
        "EnableRoslynValidation": true,
        "EnableSpeculativePlanning": false,
        "EnableScenario": false,
        "EnableMethodName": false,
        "EnableArrangePlan": false,
        "EnableInputPlan": false,
        "EnableActionPlan": false,
        "EnableAssertionPlan": false,
        "EnableFinalTest": true
      },
      "Acceptance": {
        "RequireCompilationSuccess": true,
        "RequireTestsToRun": true,
        "RequireAllTestsPass": true,
        "RequireCoverageImprovement": true,
        "MinCoverageImprovement": 0.1
      }
    },
    "MetadataEnrichmentConfig": {
      "Enabled": true,
      "UseModel": true,
      "Provider": "custom-openai",
      "Mode": "chat",
      "Temperature": 0.0,
      "RequestDelayMs": 2000,
      "MaxCategories": 3,
      "PromptVersion": "test-metadata-v1"
    },
    "TestingFrameworks": [
      {
        "patterns": [ "Test", "TestCase", "TestCaseSource", "Theory" ]
      },
      {
        "patterns": [ "Fact", "Theory" ]
      },
      {
        "patterns": [ "TestMethod", "DataSource" ]
      }
    ]
  },
  "AiProviderConfig": {
    "CustomOpenAi": {
      "Model": "GLM-5.2",
      "OrgId": "",
      "ApiKey": "",
      "Endpoint": "https://llm-api.arc.vt.edu/api/",
      "Provider": "custom-openai"
    }
  },
  "ExperimentConfig": {
    "Objective": "test-suite-expansion",
    "CandidateSelectionStrategy": "metric-driven-improvement",
    "ContextMappingMode": "heuristic-with-grounded-preference",
    "Approaches": [ "metrics-driven" ],
    "MetricsPaths": [ "coverage-and-mutation" ],
    "BudgetModes": [ "pass-at1" ],
    "ContextModes": [ "chained-history" ],
    "Temperature": 0,
    "IncludeProviders": [ "CustomOpenAi" ],
    "PreferredProvider": "CustomOpenAi",
    "ExperimentSeriesId": "custom-openai-chained-smoke-v1",
    "CandidateCohort": {
      "Id": "custom-openai-chained-smoke-v1-candidates",
      "Mode": "reuse"
    },
    "CandidateLimit": 2,
    "MinCoverageThreshold": 0.0,
    "MaxCoverageThreshold": 0.99,
    "StepErrorRetries": 0,
    "StepRetryDelayMs": 1000,
    "Resume": {
      "Enabled": true,
      "RunningAttemptTimeoutMinutes": 1,
      "RewriteResultsFileOnResume": false
    },
    "OutputPath": "D:\\Projects\\TestMap\\TestMap\\Output\\candidate-cohort-mini-swe-custom-model-results.csv",
    "IncludeDetailedErrors": true,
    "Evaluation": {
      "TestMap": {
        "Enabled": false
      },
      "Tools": {
        "Enabled": true,
        "ToolIds": [ "mini-swe-agent" ],
        "RequireAvailabilityInSetup": true
      }
    },
    "Tools": [
      {
        "Id": "mini-swe-agent",
        "ImageKey": "mini-swe-agent",
        "Provider": "CustomOpenAi",
        "Model": "GLM-5.2",
        "TimeoutMinutes": 45,
        "Endpoint": "https://llm-api.arc.vt.edu/api/",
        "RequiredEnvironmentVariables": [ "CUSTOM_API_KEY" ],
        "Environment": {
          "MINI_ALLOW_MODE": "yolo"
        }
      }
    ]
  }
}
