{
  "RuntimeConfig": {
    "Project": {
      "KeepProjectFiles": true,
      "AnalyzeLatestCommit": false
    },
    "FilePaths": {
      "TargetFilePath": "D:\\Projects\\TestMap\\TestMap\\Data\\example_project.txt",
      "LogsDirPath": "D:\\Projects\\TestMap\\TestMap\\Logs",
      "TempDirPath": "D:\\Projects\\TestMap\\Temp",
      "OutputDirPath": "D:\\Projects\\TestMap\\TestMap\\Output"
    },
    "Docker": {
      "DefaultContext": "desktop-linux",
      "WindowsContext": "desktop-windows",
      "WindowsNetwork": "nat",
      "Images": {
        "ValidationSdkAll": "testmap-validation-sdk-all:latest",
        "AgentTools": {
          "codex": "testmap-agent-eval-codex:latest",
          "gemini": "testmap-agent-eval-gemini:latest"
        }
      }
    },
    "Frameworks": {
      "NUnit": [
        "Test",
        "TestCase",
        "TestCaseSource",
        "Theory"
      ],
      "xUnit": [
        "Fact",
        "Theory"
      ],
      "MSTest": [
        "TestMethod",
        "DataSource"
      ],
      "Microsoft.VisualStudio.TestTools.UnitTesting": [
        "TestMethod",
        "DataSource"
      ]
    },
    "MaxConcurrency": 2,
    "RunDateFormat": "yyyy-MM-dd"
  },
  "TestingConfig": {
    "GenerationConfig": {
      "Objective": "test-suite-expansion",
      "Provider": "custom-openai",
      "Mode": "chat",
      "MetricsPath": "coverage-and-mutation",
      "BudgetMode": "pass-at1",
      "Temperature": 0,
      "StepErrorRetries": 0,
      "StepRetryDelayMs": 1000,
      "ContextMode": "chained-history",
      "TargetSelection": {
        "Strategy": "existing",
        "CandidateLimit": 2,
        "ContextMappingMode": "heuristic-with-grounded-preference",
        "MaxTestCodeDepth": 3,
        "MaxProductionCallDepth": 3,
        "MaxIndirectInvocationDepth": 2
      },
      "Steps": {
        "EnableEvidencePackage": true,
        "EnableContextGraph": true,
        "EnableContextResolution": true,
        "EnableRoslynValidation": true,
        "EnableSpeculativePlanning": false,
        "EnableScenario": false,
        "EnableMethodName": false,
        "EnableArrangePlan": false,
        "EnableInputPlan": false,
        "EnableActionPlan": false,
        "EnableAssertionPlan": false,
        "EnableFinalTest": true
      },
      "Acceptance": {
        "RequireCompilationSuccess": true,
        "RequireTestsToRun": true,
        "RequireAllTestsPass": true,
        "RequireCoverageImprovement": true,
        "MinCoverageImprovement": 0.1
      }
    },
    "MetadataEnrichmentConfig": {
      "Enabled": true,
      "UseModel": true,
      "Provider": "custom-openai",
      "Mode": "chat",
      "Temperature": 0.0,
      "RequestDelayMs": 2000,
      "MaxCategories": 3,
      "PromptVersion": "test-metadata-v1"
    },
    "TestingFrameworks": [
      {
        "patterns": [
          "Test",
          "TestCase",
          "TestCaseSource",
          "Theory"
        ]
      },
      {
        "patterns": [
          "Fact",
          "Theory"
        ]
      },
      {
        "patterns": [
          "TestMethod",
          "DataSource"
        ]
      }
    ]
  },
  "AiProviderConfig": {
    "OpenAi": {
      "Model": "gpt-5.1",
      "OrgId": "",
      "ApiKey": "",
      "Provider": "openai"
    },
    "Amazon": {
      "Model": "",
      "AwsAccessKey": "",
      "ApiKey": "",
      "Provider": "amazon",
      "AwsRegion": "us-east-1"
    },
    "GoogleGemini": {
      "Model": "gemini-1.5-flash",
      "ProjectId": "",
      "ApiKey": "",
      "Endpoint": "",
      "Location": "",
      "TokenPath": "",
      "Provider": "google-gemini"
    },
    "GoogleCloud": {
      "Model": "gemini-1.5-flash",
      "ProjectId": "",
      "ApiKey": "",
      "AccessToken": "",
      "Endpoint": "",
      "Location": "us-central1",
      "TokenPath": "",
      "Provider": "google-cloud"
    },
    "CustomOpenAi": {
      "Model": "gpt-oss-120b",
      "OrgId": "",
      "ApiKey": "",
      "Endpoint": "https://llm-api.arc.vt.edu/api/",
      "Provider": "custom-openai"
    },
    "Ollama": {
      "Model": "",
      "ApiKey": "",
      "Endpoint": "http://localhost:10000/",
      "Provider": "ollama"
    },
    "Anthropic": {
      "Model": "claude-sonnet-4-6",
      "ApiKey": "",
      "Provider": "anthropic"
    }
  },
  "ExperimentConfig": {
    "Objective": "test-suite-expansion",
    "CandidateSelectionStrategy": "metric-driven-improvement",
    "GenerationApproach": "metrics-driven",
    "Executor": "basic-extension",
    "Approaches": [
      "metrics-driven"
    ],
    "MetricsPaths": [
      "coverage-and-mutation"
    ],
    "BudgetModes": [
      "pass-at1-repair-at5"
    ],
    "ContextMappingMode": "heuristic-with-grounded-preference",
    "CompareHistoryModes": false,
    "ContextModes": [
      "chained-history"
    ],
    "StepAblation": {
      "Enabled": false,
      "Steps": [
        "evidence-package",
        "context-graph",
        "context-resolution",
        "roslyn-validation",
        "scenario",
        "method-name",
        "arrange-plan",
        "input-plan",
        "action-plan",
        "assertion-plan",
        "final-test"
      ],
      "IncludeBaseline": true,
      "IncludeAllDisabled": false,
      "MaxVariants": 32
    },
    "Temperature": 0,
    "IncludeProviders": [
      "CustomOpenAi"
    ],
    "PreferredProvider": "CustomOpenAi",
    "CandidateLimit": 1,
    "MinCoverageThreshold": 0.0,
    "MaxCoverageThreshold": 0.99,
    "StepErrorRetries": 3,
    "StepRetryDelayMs": 2000,
    "OutputPath": "D:\\Projects\\TestMap\\TestMap\\Output\\combined-llm-vs-tools-experiment-results.csv",
    "IncludeDetailedErrors": true,
    "Evaluation": {
      "TestMap": {
        "Enabled": true
      },
      "Tools": {
        "Enabled": true,
        "ToolIds": [
          "codex",
          "gemini"
        ],
        "RequireAvailabilityInSetup": true
      }
    },
    "Tools": [
      {
        "Id": "codex",
        "ImageKey": "codex",
        "Provider": "OpenAi",
        "Model": "gpt-5.1",
        "TimeoutMinutes": 45,
        "RequiredEnvironmentVariables": [
          "OPENAI_API_KEY"
        ],
        "Environment": {
          "CODEX_REASONING_EFFORT": "high",
          "CODEX_REASONING_SUMMARY": "auto",
          "CODEX_NETWORK_ACCESS": "true"
        }
      },
      {
        "Id": "gemini",
        "ImageKey": "gemini",
        "Provider": "GoogleGemini",
        "Model": "gemini-2.5-pro",
        "TimeoutMinutes": 45,
        "RequiredEnvironmentVariables": [ "GEMINI_API_KEY" ],
        "Environment": {
          "GEMINI_MODEL": "gemini-2.5-pro",
          "GEMINI_OUTPUT_FORMAT": "stream-json",
          "GEMINI_APPROVAL_MODE": "yolo",
          "GEMINI_SANDBOX": "false"
        }
      }
    ]
  }
}
