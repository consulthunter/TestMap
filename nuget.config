<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- TestMap depends on DotNetCodeMetrics.Core and XNoseNext.Core, published to GitHub Packages.
         Restoring from this feed requires authentication (a token with read:packages). Locally this
         comes from your user-level NuGet config; in CI it is injected by the workflow. -->
    <add key="github" value="https://nuget.pkg.github.com/consulthunter/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
